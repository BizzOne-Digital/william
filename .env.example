# Public site URL (used in emails, sitemap, Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/intense-dropz?retryWrites=true&w=majority

# Auth.js / NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-long-random-secret
AUTH_URL=http://localhost:3000

# First admin (run npm run seed:admin once — never commit real values)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-strong-password-min-12-chars

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (hosting.com cPanel mailbox — From must match SMTP_USER for deliverability)
SMTP_HOST=mail.intensedropz.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@intensedropz.ca
SMTP_PASS=
EMAIL_FROM="Intense Dropz <orders@intensedropz.ca>"
BUSINESS_NOTIFICATION_EMAIL=orders@intensedropz.ca

# Form spam / rate-limit salt
FORM_IP_SALT=replace-with-random-string

# Local pickup checkout (pay in person; no online payment)
PICKUP_ORDERS_ENABLED=true

# Payments — Interac e-Transfer (default when Stripe is not configured)
PAYMENT_PROVIDER=etransfer
ETRANSFER_EMAIL=info@intensedropz.ca
ETRANSFER_PAYMENT_HOURS=24

# Payments — Stripe Checkout (optional; set PAYMENT_PROVIDER=stripe)
# Set PAYMENTS_ENABLED=false only to block checkout while keeping keys in env.
PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
